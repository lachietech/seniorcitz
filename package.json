{
  "name": "sandgate-senior-citezens-page",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "vite preview --host 127.0.0.1",
    "format": "prettier --write \"frontend/**/*.{js,jsx,html,css}\" vite.config.js",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,html,css}\" vite.config.js",
    "test": "npm run build && playwright test",
    "test:dev": "playwright test --config playwright.dev.config.js"
  },
  "author": "Lachlan Nielsen",
  "type": "module",
  "license": "ISC",
  "description": "Static React website for Sandgate Seniors, powered by Nielsen Innovations APIs",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "3.6.2",
    "vite": "^8.3.5"
  }
}
